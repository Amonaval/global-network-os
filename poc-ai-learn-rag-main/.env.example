# ═══════════════════════════════════════════════════════════════
#  Knowledge RAG — Environment Config
#  Copy to .env  ·  Everything in LOCAL section works out of box
# ═══════════════════════════════════════════════════════════════

# ── MODE ────────────────────────────────────────────────────────
# "local"  → Ollama LLM + TF-IDF embeddings + JSON file DB (POC, no keys)
# "cloud"  → Claude API + OpenAI embeddings + SQLite or Pinecone
#APP_MODE=local

# ── LLM ─────────────────────────────────────────────────────────
# LOCAL: Ollama (free, runs on your machine)
#   Install: https://ollama.com  then run: ollama pull llama3.2
#   Or lighter: ollama pull mistral  /  ollama pull phi3
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# CLOUD (fill in when ready, then set LLM_PROVIDER=claude):
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── EMBEDDINGS ──────────────────────────────────────────────────
# nomic  = local semantic (RECOMMENDED - run: ollama pull nomic-embed-text)
# tfidf  = local keyword (fallback, no extra install)
# openai = cloud (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=nomic
NOMIC_MODEL=nomic-embed-text

# ── HYBRID SEARCH ────────────────────────────────────────────────
# 0.0 = pure semantic | 0.5 = balanced hybrid (default) | 1.0 = pure BM25
HYBRID_WEIGHT=0.5

# ── CONTEXT COMPRESSION ──────────────────────────────────────────
# Max tokens of documentation context sent to the LLM per query
CTX_TOKEN_BUDGET=1800
# Minimum relevance score to include a chunk (0.0-1.0)
MIN_CHUNK_SCORE=0.03

# ── VECTOR STORE ─────────────────────────────────────────────────
# LOCAL: JSON file (zero deps, works immediately)
VECTOR_STORE_PROVIDER=json
VECTOR_DB_PATH=./data/vectors.json

# CLOUD (fill in when ready):
# VECTOR_STORE_PROVIDER=pinecone
# PINECONE_API_KEY=...
# PINECONE_INDEX=knowledge-docs

# ── CRAWLER ──────────────────────────────────────────────────────
AUTH_EMAIL=email
AUTH_PASSWORD=pass
DOCS_DIR=./docs

# ── INGESTION ────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=60

# ── RAG ──────────────────────────────────────────────────────────
TOP_K=6

# ── SERVER ───────────────────────────────────────────────────────
PORT=3001
