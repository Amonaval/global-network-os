{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-ts",
    "rootDir": "./",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "electron.js",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-ts",
    "public",
    "docs",
    "data",
    "user_data"
  ]
}
